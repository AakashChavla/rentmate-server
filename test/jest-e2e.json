{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.spec.json"
      }
    ]
  },
  "setupFiles": ["reflect-metadata", "<rootDir>/test/support/setup-env.ts"],
  "maxWorkers": 1,
  "forceExit": true,
  "testTimeout": 120000
}
