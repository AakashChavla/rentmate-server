{
  "name": "rentmate-server",
  "version": "0.1.0",
  "private": true,
  "description": "RentMate API and background worker",
  "author": "Aakash Chavla",
  "license": "UNLICENSED",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "worker": "ts-node src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "seed": "ts-node src/database/seeds/run-seed.ts",
    "rules:check": "ts-node tools/check-rules.ts",
    "arch:check": "depcruise src",
    "gen": "plop --plopfile tools/codegen/plopfile.js",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "setupFiles": [
      "reflect-metadata"
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/bullmq": "11",
    "@nestjs/common": "11",
    "@nestjs/config": "4",
    "@nestjs/core": "11",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "11",
    "@nestjs/platform-express": "11",
    "@nestjs/swagger": "11",
    "@nestjs/terminus": "11",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "11",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "4.6.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "9",
    "jest": "^30.5.2",
    "lint-staged": "16",
    "pino-pretty": "^13.1.3",
    "plop": "^4.0.5",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
