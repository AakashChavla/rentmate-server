{
  "name": "rentmate-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"tools/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" \"tools/**/*.ts\" --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "rules:check": "tsx tools/check-rules.ts",
    "i18n:check": "tsx tools/check-i18n.ts",
    "i18n:types": "tsx tools/generate-i18n.ts",
    "rules:proof": "tsx tools/prove-rules.ts",
    "gen": "plop --plopfile tools/codegen/plopfile.cjs",
    "prepare": "husky",
    "verify:quick": "yarn lint && yarn typecheck && yarn arch:check && yarn rules:check && yarn i18n:check && yarn test && yarn build",
    "dev": "tsx watch src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node tools/copy-catalogs.cjs",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:int": "tsx tools/infrastructure-gate.ts integration",
    "test:e2e": "tsx tools/infrastructure-gate.ts e2e",
    "verify": "yarn verify:quick && yarn test:int && yarn test:e2e",
    "openapi:export": "tsx tools/openapi-export.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.12.0",
    "pino-http": "^10.5.0",
    "nestjs-i18n": "10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0",
    "helmet": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "class-validator": "^0.14.2"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0",
    "dependency-cruiser": "^16.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "tsx": "^4.20.0",
    "plop": "^4.0.0",
    "@types/node": "^20.19.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/supertest": "^6.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "supertest": "^7.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,json,md,cjs,mjs,yml,css}": "prettier --write"
  },
  "resolutions": {
    "nestjs-i18n/cookie": "0.7.2",
    "@nestjs/swagger/js-yaml": "5.4.1"
  }
}
