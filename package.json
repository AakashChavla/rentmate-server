{
  "name": "rentmate-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"tools/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" \"tools/**/*.ts\" --fix",
    "format": "node tools/format-atomic.cjs",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "rules:check": "tsx tools/check-rules.ts",
    "i18n:check": "tsx tools/check-i18n.ts",
    "i18n:types": "tsx tools/generate-i18n.ts",
    "rules:proof": "tsx tools/prove-rules.ts",
    "gen": "plop --plopfile tools/codegen/plopfile.cjs",
    "prepare": "husky",
    "verify:quick": "yarn lint && yarn typecheck && yarn arch:check && yarn rules:check && yarn auth-scope:check && yarn i18n:check && yarn test && yarn test:e2e && yarn build",
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/main.ts",
    "start:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/main.ts",
    "build": "tsc -p tsconfig.build.json && node tools/copy-catalogs.cjs",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:int": "jest --runInBand --config jest.int.config.cjs",
    "test:e2e": "jest --runInBand --config jest.e2e.config.cjs",
    "verify": "yarn verify:quick && yarn test:int",
    "openapi:export": "tsx tools/openapi-export.ts",
    "migration:run": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local tools/migrate.ts",
    "migration:generate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local tools/migration-diff.ts",
    "seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local tools/seeds/run.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/worker.ts",
    "auth-scope:check": "tsx tools/check-auth-scope.ts",
    "audit": "yarn npm audit --all --recursive"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "argon2": "0.45.1",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nestjs-i18n": "10.8.5",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.14",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "plop": "4.0.5",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,json,md,cjs,mjs,yml,css}": "prettier --write"
  }
}
