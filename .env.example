NODE_ENV=development
PORT=3000

# Use DATABASE_URL, or the DB_* variables below. DATABASE_URL wins when both are set.
DATABASE_URL=postgresql://rentmate:rentmate@localhost:5432/rentmate
DB_HOST=localhost
DB_PORT=5432
DB_USER=rentmate
DB_PASSWORD=rentmate
DB_NAME=rentmate

REDIS_URL=redis://localhost:6379

# Development placeholders. Replace these outside your local machine.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:3001
COOKIE_DOMAIN=

PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

S3_BUCKET=
S3_REGION=
SENDGRID_API_KEY=
