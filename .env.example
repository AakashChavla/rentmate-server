NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentmate2
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3001
TRUST_PROXY=0
SWAGGER_ENABLED=true
THROTTLE_LIMIT=120
THROTTLE_WINDOW_MS=60000
WORKER_CONCURRENCY=5

# Generate three independent cryptographically random secrets (minimum 32 characters).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HMAC_SECRET=
# Leave empty for host-only cookies. Production requires HTTPS.
# COOKIE_DOMAIN=.your-domain.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@rentmate.local
# Optional provider credentials; supply through local environment or secret manager.
# SMTP_USER=
# SMTP_PASSWORD=
# Platform seed: PLATFORM_ADMIN_EMAIL and PLATFORM_ADMIN_PASSWORD
# Development-only demo seed: DEMO_SEED_PASSWORD (10-128 characters, letter + number)
