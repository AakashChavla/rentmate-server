NODE_ENV=development
PORT=3000

# Use DATABASE_URL, or the DB_* variables below. DATABASE_URL wins when both are set.
DATABASE_URL=postgresql://rentmate:rentmate@localhost:5432/rentmate
DB_HOST=localhost
DB_PORT=5432
DB_USER=rentmate
DB_PASSWORD=rentmate
DB_NAME=rentmate

REDIS_URL=redis://localhost:6379

# Development placeholders. Replace these outside your local machine.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:3001
COOKIE_DOMAIN=

PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

S3_BUCKET=
S3_REGION=

EMAIL_PROVIDER=smtp
EMAIL_FROM="RentMate <your-gmail@gmail.com>"
EMAIL_REPLY_TO=

# Gmail SMTP usage:
# 1. Turn on 2-Step Verification on your Google account.
# 2. Generate a 16-character App Password in Security settings.
# 3. Use that 16-character App Password (without spaces) as SMTP_PASSWORD.
# Note: Gmail rewrites the From header to match the authenticated SMTP_USER account unless an alias ("Send mail as") is configured in Gmail settings, so EMAIL_FROM should match it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Local only. Startup fails when this is true and NODE_ENV=production.
AUTH_DEV_LOG_OTP=false

# Required by `yarn seed`. Demo users are created only when NODE_ENV=development.
SEED_SUPER_ADMIN_EMAIL=admin@rentmate.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe12345
SEED_DEMO_PASSWORD=DemoUser12345
