NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentmate2
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3001
TRUST_PROXY=0
SWAGGER_ENABLED=true
THROTTLE_LIMIT=120
THROTTLE_WINDOW_MS=60000
WORKER_CONCURRENCY=5

# Generate three independent cryptographically random secrets (minimum 32 characters).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HMAC_SECRET=
# Private KYC storage. Generate independent 32-byte hex encryption and HMAC keys.
# FIELD_KEYS is a JSON map of key IDs to 64-character hex keys; retain previous IDs when rotating.
FIELD_KEY_ID=dev-v1
FIELD_KEYS=
FIELD_HASH_KEY=
FILE_STORAGE=local
FILE_LOCAL_PATH=.rentmate-private/documents
# S3 mode: private bucket, HTTPS endpoint (optional for AWS), scoped credentials or IAM role.
S3_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Leave empty for host-only cookies. Production requires HTTPS.
# COOKIE_DOMAIN=.your-domain.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@rentmate.local
# Optional provider credentials; supply through local environment or secret manager.
# SMTP_USER=
# SMTP_PASSWORD=
# Platform seed: PLATFORM_ADMIN_EMAIL and PLATFORM_ADMIN_PASSWORD
# Development-only demo seed: DEMO_SEED_PASSWORD (10-128 characters, letter + number)

# Optional local-only demo dataset; generate a strong password, never commit it.
DEMO_SEED_PASSWORD=
